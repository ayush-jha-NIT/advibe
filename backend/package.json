{
  "name": "@advibe/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src tests",
    "test": "node --import tsx --test tests/app.test.ts tests/env.test.ts",
    "smoke": "node scripts/smoke.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run test:db && npm run test:auth && npm run build && npm run smoke",
    "postinstall": "prisma generate --schema prisma/schema.prisma",
    "db:validate": "prisma validate --schema prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:migrate:dev": "prisma migrate dev --schema prisma/schema.prisma",
    "db:seed:dev": "tsx prisma/seed.ts",
    "test:db": "node --import tsx --test tests/db.integration.test.ts",
    "test:auth": "node --import tsx --test tests/auth.integration.test.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "pino": "^9.9.0",
    "zod": "^4.1.0",
    "@prisma/client": "6.19.0",
    "argon2": "^0.44.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "eslint": "^9.38.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "prisma": "6.19.0"
  }
}
