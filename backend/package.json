{
  "name": "@advibe/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src tests",
    "test": "node --import tsx --test tests/app.test.ts tests/env.test.ts",
    "smoke": "node scripts/smoke.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run test:db && npm run test:auth && npm run test:security && npm run test:accounts && npm run test:drivers && npm run test:kyc && npm run test:devices && npm run test:geo && npm run test:creatives && npm run test:pricing && npm run test:campaigns && npm run test:reservations && npm run test:payments && npm run test:delivery && npm run test:player && npm run build && npm run smoke",
    "postinstall": "prisma generate --schema prisma/schema.prisma",
    "db:validate": "prisma validate --schema prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:migrate:dev": "prisma migrate dev --schema prisma/schema.prisma",
    "db:seed:dev": "tsx prisma/seed.ts",
    "test:db": "node --import tsx --test tests/db.integration.test.ts",
    "test:auth": "node --import tsx --test tests/auth.integration.test.ts",
    "admin:mfa": "tsx src/modules/auth/operator-mfa.ts",
    "test:security": "node --import tsx --test tests/security.integration.test.ts",
    "test:accounts": "node --import tsx --test tests/accounts.integration.test.ts",
    "test:drivers": "node --import tsx --test tests/drivers.integration.test.ts",
    "test:kyc": "node --import tsx --test tests/kyc.integration.test.ts",
    "test:devices": "node --import tsx --test tests/devices.integration.test.ts",
    "test:geo": "node --import tsx --test tests/geo.integration.test.ts",
    "creative:worker": "node --env-file-if-exists=.env --import tsx scripts/process-creatives.ts",
    "test:creatives": "node --import tsx --test tests/creatives.integration.test.ts",
    "test:pricing": "node --import tsx --test tests/pricing.integration.test.ts",
    "test:campaigns": "node --import tsx --test tests/campaigns.integration.test.ts",
    "test:reservations": "node --import tsx --test tests/reservations.integration.test.ts",
    "reservations:sweep": "node --env-file-if-exists=.env --import tsx scripts/expire-reservations.ts",
    "test:payments": "node --import tsx --test tests/payments.integration.test.ts",
    "test:delivery": "node --import tsx --test tests/delivery.integration.test.ts",
    "delivery:tick": "node --env-file-if-exists=.env --import tsx scripts/tick-delivery.ts",
    "test:player": "node --import tsx --test tests/player.integration.test.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "pino": "^9.9.0",
    "zod": "^4.1.0",
    "@prisma/client": "6.19.0",
    "argon2": "^0.44.0",
    "@aws-sdk/client-s3": "^3.910.0",
    "@aws-sdk/s3-request-presigner": "^3.910.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "eslint": "^9.38.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "prisma": "6.19.0"
  }
}
