# LOCAL DEVELOPMENT ONLY. Do not commit real credentials.
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
TRUST_PROXY=false

# B2 pooled runtime URL, unpooled migration URL. Production TLS required.
DATABASE_URL=postgresql://advibe_local:replace_me@localhost:5432/advibe_dev?schema=public
DIRECT_URL=postgresql://advibe_local:replace_me@localhost:5432/advibe_dev?schema=public

# B3/B4 server session HMAC and separate Admin MFA AES-256-GCM key.
AUTH_SECRET=replace_with_at_least_32_random_characters_for_local_use_only
AUTH_WEB_ORIGIN=http://localhost:3000
# MFA_ENCRYPTION_KEY=<64 hexadecimal characters, separate from AUTH_SECRET>
# RESEND_API_KEY=
# AUTH_EMAIL_FROM=AdVibe <auth@verified-domain.example>

# B5 verified public enquiry CAPTCHA.
# ENQUIRY_TURNSTILE_SECRET=
# ENQUIRY_TURNSTILE_HOSTNAME=app.example.com

# B6 has no new secrets. Optional vehicle registrationToken must be an
# opaque provider token; do not send raw vehicle plates, RC or ID documents.
# B7 handles private KYC storage and agreement acceptance.

# B7 sensitive document storage: private, encrypted, VERSIONED S3 bucket; server IAM only.
# Never use NEXT_PUBLIC or place these in a browser bundle.
# KYC_S3_BUCKET=
# KYC_S3_REGION=
# AWS_ACCESS_KEY_ID=           (prefer workload IAM credentials, not static keys)
# AWS_SECRET_ACCESS_KEY=
# KYC_SCAN_SECRET=            (32+ random chars; separate from auth and MFA keys)
# KYC_RETENTION_DAYS=         (approved privacy/legal retention, 1..365)
# DRIVER_AGREEMENT_VERSION=   (legal-reviewed published template identifier)
# DRIVER_AGREEMENT_SHA256=    (SHA-256 of exact published agreement)
# DRIVER_PRIVACY_VERSION=     (legal-reviewed privacy notice version)

# B8: manufacturer-installed Ed25519 public key, Admin-approved pairing.
# DEVICE_MANIFEST_SIGNING_KEY_PKCS8_B64=  (private Ed25519 PKCS8 DER encoded as base64url)
# Pin the matching public key in actual firmware; do not dynamically trust a website key.
# No vendor attestation, real installed devices or live playback until hardware/pilot approval.

# B10 private versioned, AES-256 S3 creative storage; never public buckets.
# CREATIVE_S3_BUCKET=
# CREATIVE_S3_REGION=
# CREATIVE_WORKER_ENABLED=true (ONLY inside isolated scheduled processing worker)
# Install patched FFmpeg/ffprobe and ClamAV inside the worker image.
# Staging test fixtures must use mock storage and mock processor; no fake live scan.
