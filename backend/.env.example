# Copy to backend/.env for local development. Do not commit backend/.env.
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
TRUST_PROXY=false

# B1 has no database, Redis, authentication or payment credentials.
# Never use NEXT_PUBLIC_ for server secrets.

# B2: provision a dedicated Neon project and use URLs only as private env vars.
# DATABASE_URL = pooled runtime URL; DIRECT_URL = unpooled migration URL.
# Production URLs must use TLS with ?sslmode=require or stronger.
# Example for LOCAL DEV only (do not reuse credentials in real environments):
DATABASE_URL=postgresql://advibe_local:replace_me@localhost:5432/advibe_dev?schema=public
DIRECT_URL=postgresql://advibe_local:replace_me@localhost:5432/advibe_dev?schema=public

# db:seed:dev requires an explicit DEV_SEED_ACK=true and localhost database.

# B3: use an independently generated >=32-character application secret.
# AUTH_SECRET MUST be the same across all API instances; rotate only with coordinated session revocation.
AUTH_SECRET=replace_with_at_least_32_random_characters_for_local_use_only
AUTH_WEB_ORIGIN=http://localhost:3000
# Production requires a verified sending domain, API key, and Resend sender.
# RESEND_API_KEY=
# AUTH_EMAIL_FROM=AdVibe <auth@your-verified-domain.example>

# B4: a DIFFERENT randomly generated 32-byte key, hexadecimal (64 characters).
# Never reuse AUTH_SECRET for encrypting Admin TOTP secrets.
# MFA_ENCRYPTION_KEY=

# B5 public enquiries: Cloudflare Turnstile widget with action "enquiry".
# Production requires the private secret and exact verified frontend hostname.
# ENQUIRY_TURNSTILE_SECRET=
# ENQUIRY_TURNSTILE_HOSTNAME=app.example.com
