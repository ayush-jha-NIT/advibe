// AdVibe B2: initial identity and transactional infrastructure.
// Modules B5-B21 extend this schema with approved business/domain requirements.
// Prisma 6 pinned to avoid automatic Prisma 7 datasource/adapter changes.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AccountRole {
  ADVERTISER
  DRIVER
  ADMIN
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CLOSED
}

enum BusinessRole {
  OWNER
  MANAGER
  VIEWER
}

enum BusinessVerificationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum EnquiryStatus {
  NEW
  REVIEWED
  CLOSED
}

enum ChallengePurpose {
  VERIFY_EMAIL
  PASSWORD_RESET
  LOGIN_OTP
}

enum IdempotencyState {
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum OutboxState {
  PENDING
  PUBLISHED
  FAILED
}

model User {
  id              String               @id @default(uuid()) @db.Uuid
  email           String               @unique @db.VarChar(320)
  displayName     String               @db.VarChar(160)
  city            String?              @db.VarChar(100)
  passwordHash    String?              @db.VarChar(255)
  role            AccountRole          @default(ADVERTISER)
  status          AccountStatus        @default(PENDING)
  emailVerifiedAt DateTime?            @db.Timestamptz(6)
  createdAt       DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime             @updatedAt @db.Timestamptz(6)
  sessions        Session[]
  challenges      OtpChallenge[]
  ownedBusinesses Business[]           @relation("BusinessOwner")
  memberships     BusinessMembership[]
  auditEvents     AuditEvent[]         @relation("AuditActor")
  mfaCredential   AdminMfaCredential?
  mfaChallenges   MfaLoginChallenge[]
  driverApplications DriverApplication[]
  driverVehicles  Vehicle[]
  reviewedKycDocuments DriverDocument[] @relation("DocumentReviewer")
  driverReviewDecisions DriverApplicationReview[] @relation("ApplicationReviewer")

  @@index([status, createdAt])
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique @db.Char(64)
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  expiresAt  DateTime  @db.Timestamptz(6)
  lastSeenAt DateTime? @db.Timestamptz(6)
  revokedAt  DateTime? @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  mfaVerifiedAt DateTime? @db.Timestamptz(6)

  @@index([userId, revokedAt, expiresAt])
  @@index([expiresAt])
}

model OtpChallenge {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String?          @db.Uuid
  email      String           @db.VarChar(320)
  purpose    ChallengePurpose
  codeHash   String           @db.Char(64)
  attempts   Int              @default(0)
  expiresAt  DateTime         @db.Timestamptz(6)
  consumedAt DateTime?        @db.Timestamptz(6)
  createdAt  DateTime         @default(now()) @db.Timestamptz(6)
  user       User?            @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([email, purpose, createdAt])
  @@index([expiresAt])
  @@index([purpose, consumedAt, expiresAt])
}

model Business {
  id           String               @id @default(uuid()) @db.Uuid
  ownerUserId  String               @db.Uuid
  slug         String               @unique @db.VarChar(100)
  displayName  String               @db.VarChar(180)
  legalName    String?              @db.VarChar(220)
  city         String?              @db.VarChar(100)
  verificationStatus BusinessVerificationStatus @default(PENDING)
  archivedAt   DateTime?            @db.Timestamptz(6)
  createdAt    DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime             @updatedAt @db.Timestamptz(6)
  owner        User                 @relation("BusinessOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  memberships  BusinessMembership[]
  mediaAssets  MediaAsset[]
  creatives     Creative[]
  quotes        PriceQuote[]
  campaigns     Campaign[]
  reservationHolds ReservationHold[]
  paymentOrders PaymentOrder[]

  @@index([ownerUserId])
  @@index([archivedAt, createdAt])
}

model BusinessMembership {
  id         String       @id @default(uuid()) @db.Uuid
  businessId String       @db.Uuid
  userId     String       @db.Uuid
  role       BusinessRole @default(VIEWER)
  createdAt  DateTime     @default(now()) @db.Timestamptz(6)
  revokedAt  DateTime?    @db.Timestamptz(6)
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Restrict)
  user       User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([businessId, userId])
  @@index([userId, revokedAt])
}

model AuditEvent {
  id           String    @id @default(uuid()) @db.Uuid
  actorUserId  String?   @db.Uuid
  action       String    @db.VarChar(120)
  resourceType String    @db.VarChar(80)
  resourceId   String    @db.VarChar(128)
  requestId    String?   @db.VarChar(128)
  metadata     Json?
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  actor        User?     @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([resourceType, resourceId, createdAt])
  @@index([actorUserId, createdAt])
}

model IdempotencyRecord {
  id           String           @id @default(uuid()) @db.Uuid
  actorScope   String           @db.VarChar(180)
  requestPath  String           @db.VarChar(200)
  key          String           @db.VarChar(160)
  requestHash  String           @db.Char(64)
  state        IdempotencyState @default(IN_PROGRESS)
  resourceId   String?          @db.VarChar(128)
  responseCode Int?
  expiresAt    DateTime         @db.Timestamptz(6)
  createdAt    DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime         @updatedAt @db.Timestamptz(6)

  @@unique([actorScope, requestPath, key])
  @@index([expiresAt])
}

model OutboxEvent {
  id            String      @id @default(uuid()) @db.Uuid
  aggregateType String      @db.VarChar(80)
  aggregateId   String      @db.VarChar(128)
  eventType     String      @db.VarChar(160)
  payload       Json
  state         OutboxState @default(PENDING)
  attempts      Int         @default(0)
  availableAt   DateTime    @default(now()) @db.Timestamptz(6)
  publishedAt   DateTime?   @db.Timestamptz(6)
  createdAt     DateTime    @default(now()) @db.Timestamptz(6)

  @@index([state, availableAt])
  @@index([aggregateType, aggregateId, createdAt])
}

model AdminMfaCredential {
  userId       String    @id @db.Uuid
  secretCipher String    @db.VarChar(500)
  enabledAt    DateTime? @db.Timestamptz(6)
  lastUsedStep BigInt    @default(-1)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(6)
  user         User      @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model MfaLoginChallenge {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  tokenHash   String    @db.Char(64)
  attempts    Int       @default(0)
  expiresAt   DateTime  @db.Timestamptz(6)
  consumedAt  DateTime? @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  user        User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, consumedAt, expiresAt])
  @@index([expiresAt])
}

model Enquiry {
  id                String        @id @default(uuid()) @db.Uuid
  name              String        @db.VarChar(100)
  email             String        @db.VarChar(320)
  subject           String        @db.VarChar(120)
  message           String        @db.VarChar(1500)
  status            EnquiryStatus @default(NEW)
  consentAt         DateTime      @db.Timestamptz(6)
  captchaVerifiedAt DateTime      @db.Timestamptz(6)
  submitterHash     String        @db.Char(64)
  createdAt         DateTime      @default(now()) @db.Timestamptz(6)

  @@index([status, createdAt])
  @@index([createdAt])
}


// B6: application drafts are private, driver-owned, and never self-approved.
enum DriverApplicationState {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

enum DriverExperience {
  NEW
  UNDER_ONE
  ONE_TO_THREE
  OVER_THREE
}

enum VehicleType {
  BIKE
  AUTO
  CAR
}

enum VehicleVerification {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

model Vehicle {
  id                    String              @id @default(uuid()) @db.Uuid
  driverUserId          String              @db.Uuid
  type                  VehicleType
  model                 String              @db.VarChar(100)
  year                  Int
  registrationTokenHash String?             @unique @db.Char(64)
  verification          VehicleVerification @default(PENDING)
  createdAt             DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime            @updatedAt @db.Timestamptz(6)
  driver                User                @relation(fields: [driverUserId], references: [id], onDelete: Restrict)
  applications          DriverApplication[] @relation("ApplicationVehicle")
  screens               Screen[]

  @@unique([id, driverUserId])
  @@index([driverUserId, createdAt, id])
}

model DriverApplication {
  id                       String                 @id @default(uuid()) @db.Uuid
  driverUserId             String                 @db.Uuid
  state                    DriverApplicationState @default(DRAFT)
  completedStep            Int                    @default(0)
  version                  Int                    @default(0)
  city                     String?                @db.VarChar(100)
  experience               DriverExperience?
  vehicleId                String?                @db.Uuid
  vehicleCategory          VehicleType?
  screenChoice             String?                @db.VarChar(80)
  agreementTemplateVersion String?                @db.VarChar(100)
  confirmedReadiness       Boolean                @default(false)
  submittedAt              DateTime?              @db.Timestamptz(6)
  createdAt                DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime               @updatedAt @db.Timestamptz(6)
  driver                   User                   @relation(fields: [driverUserId], references: [id], onDelete: Restrict)
  vehicle                  Vehicle?               @relation("ApplicationVehicle", fields: [vehicleId, driverUserId], references: [id, driverUserId], onDelete: Restrict)

  documents DriverDocument[]
  agreements DriverAgreement[]
  reviews DriverApplicationReview[]

  @@unique([id, driverUserId])
  @@index([driverUserId, createdAt, id])
  @@index([state, submittedAt])
}

enum KycDocumentKind {
  LICENCE
  REGISTRATION
  INSURANCE
  OTHER
}
enum KycDocumentStatus {
  PENDING_UPLOAD
  UPLOADED
  SCAN_CLEAN
  SCAN_REJECTED
  VERIFIED
  REJECTED
}
enum DriverReviewDecision {
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

model DriverDocument {
  id                String            @id @default(uuid()) @db.Uuid
  applicationId     String            @db.Uuid
  driverUserId      String            @db.Uuid
  kind              KycDocumentKind
  contentType       String            @db.VarChar(60)
  sizeBytes         Int
  storageKey        String            @unique @db.VarChar(350)
  storageVersionId  String?           @db.VarChar(200)
  sha256            String?           @db.Char(64)
  status            KycDocumentStatus @default(PENDING_UPLOAD)
  uploadExpiresAt   DateTime          @db.Timestamptz(6)
  uploadedAt        DateTime?         @db.Timestamptz(6)
  scannedAt         DateTime?         @db.Timestamptz(6)
  reviewedAt        DateTime?         @db.Timestamptz(6)
  reviewedByUserId  String?           @db.Uuid
  retentionUntil    DateTime          @db.Timestamptz(6)
  createdAt         DateTime          @default(now()) @db.Timestamptz(6)
  application       DriverApplication @relation(fields: [applicationId, driverUserId], references: [id, driverUserId], onDelete: Restrict)
  reviewer          User?             @relation("DocumentReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict)
  scanEvents        KycScanEvent[]

  @@index([applicationId, kind, status])
  @@index([retentionUntil])
  @@index([driverUserId, createdAt])
}

model KycScanEvent {
  id            String         @id @default(uuid()) @db.Uuid
  providerEventId String       @unique @db.VarChar(100)
  documentId    String         @db.Uuid
  verdict       String         @db.VarChar(30)
  digest        String         @db.Char(64)
  createdAt     DateTime       @default(now()) @db.Timestamptz(6)
  document      DriverDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@index([documentId, createdAt])
}

model DriverAgreement {
  id                 String            @id @default(uuid()) @db.Uuid
  applicationId      String            @db.Uuid
  driverUserId       String            @db.Uuid
  templateVersion    String            @db.VarChar(100)
  templateSha256     String            @db.Char(64)
  privacyVersion     String            @db.VarChar(100)
  acceptedIpHash     String            @db.Char(64)
  acceptedAt         DateTime          @default(now()) @db.Timestamptz(6)
  application        DriverApplication @relation(fields: [applicationId, driverUserId], references: [id, driverUserId], onDelete: Restrict)

  @@unique([applicationId, templateVersion, templateSha256])
  @@index([driverUserId, acceptedAt])
}

model DriverApplicationReview {
  id            String               @id @default(uuid()) @db.Uuid
  applicationId String               @db.Uuid
  adminUserId   String               @db.Uuid
  decision      DriverReviewDecision
  reason        String?              @db.VarChar(2000)
  evidence      Json
  createdAt     DateTime             @default(now()) @db.Timestamptz(6)
  application   DriverApplication    @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  admin         User                 @relation("ApplicationReviewer", fields: [adminUserId], references: [id], onDelete: Restrict)

  @@index([applicationId, createdAt])
  @@index([adminUserId, createdAt])
}


// B8: provisioning and cryptographic pairing are NOT physical installation approval.
enum ScreenPlacement {
  BIKE_REAR
  AUTO_REAR
  AUTO_SIDE
  CAR_REAR
  CAR_INTERIOR
  HELMET
}

enum ScreenState {
  UNPAIRED
  PAIRED
  REVOKED
}

model Screen {
  id             String            @id @default(uuid()) @db.Uuid
  vehicleId      String            @db.Uuid
  placement      ScreenPlacement
  state          ScreenState       @default(UNPAIRED)
  installationReference String     @db.VarChar(120)
  createdAt      DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(6)
  vehicle        Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  credential     DeviceCredential?
  inventorySlots InventorySlot[]
  holdItems      ReservationHoldItem[]
  challenges     DevicePairingChallenge[]
  manifests      DeviceManifestVersion[]
  // B11 prices refer to immutable snapshots, never mutable screen records.
  locationId     String?           @db.Uuid
  location       Location?          @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@index([vehicleId, state])
  @@index([locationId, state])
}

model DeviceCredential {
  id               String    @id @default(uuid()) @db.Uuid
  screenId         String    @unique @db.Uuid
  publicKeySpki    String    @db.VarChar(256)
  fingerprint      String    @db.Char(64)
  pairedAt         DateTime  @default(now()) @db.Timestamptz(6)
  revokedAt        DateTime? @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(6)
  screen           Screen    @relation(fields: [screenId], references: [id], onDelete: Restrict)
  requestNonces    DeviceRequestNonce[]
  heartbeats       DeviceHeartbeat[]

  @@index([fingerprint])
}

model DevicePairingChallenge {
  id              String    @id @default(uuid()) @db.Uuid
  screenId        String    @db.Uuid
  adminUserId     String    @db.Uuid
  publicKeySpki   String    @db.VarChar(256)
  nonce           String    @db.VarChar(64)
  expiresAt       DateTime  @db.Timestamptz(6)
  consumedAt      DateTime? @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  screen          Screen    @relation(fields: [screenId], references: [id], onDelete: Restrict)

  @@index([screenId, consumedAt, expiresAt])
  @@index([expiresAt])
}

model DeviceRequestNonce {
  id            String           @id @default(uuid()) @db.Uuid
  credentialId  String           @db.Uuid
  nonce         String           @db.VarChar(64)
  receivedAt    DateTime         @default(now()) @db.Timestamptz(6)
  credential    DeviceCredential @relation(fields: [credentialId], references: [id], onDelete: Restrict)

  @@unique([credentialId, nonce])
  @@index([receivedAt])
}

model DeviceHeartbeat {
  id            String           @id @default(uuid()) @db.Uuid
  credentialId  String           @db.Uuid
  deviceEventId String           @db.VarChar(128)
  observedAt    DateTime         @db.Timestamptz(6)
  receivedAt    DateTime         @default(now()) @db.Timestamptz(6)
  firmwareVersion String         @db.VarChar(100)
  credential    DeviceCredential @relation(fields: [credentialId], references: [id], onDelete: Restrict)

  @@unique([credentialId, deviceEventId])
  @@index([credentialId, receivedAt])
}

model DeviceManifestVersion {
  id         String    @id @default(uuid()) @db.Uuid
  screenId   String    @db.Uuid
  version    Int
  expiresAt  DateTime  @db.Timestamptz(6)
  entries    Json
  signature  String    @db.VarChar(128)
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  screen     Screen    @relation(fields: [screenId], references: [id], onDelete: Restrict)

  @@unique([screenId, version])
}


// B9 location catalog: curated sites only, never trip/GPS history.
enum CatalogState {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model City {
  id            String       @id @default(uuid()) @db.Uuid
  slug          String       @unique @db.VarChar(100)
  name          String       @db.VarChar(120)
  countryCode   String       @db.Char(2)
  timeZone      String       @db.VarChar(100)
  state         CatalogState @default(DRAFT)
  createdAt     DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @db.Timestamptz(6)
  zones         Zone[]
  rateRules     RateRule[]

  @@index([state, name, id])
}

model Zone {
  id            String       @id @default(uuid()) @db.Uuid
  cityId        String       @db.Uuid
  slug          String       @db.VarChar(100)
  name          String       @db.VarChar(120)
  centerLat     Float
  centerLng     Float
  radiusMeters  Int
  state         CatalogState @default(DRAFT)
  createdAt     DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @db.Timestamptz(6)
  city          City         @relation(fields: [cityId], references: [id], onDelete: Restrict)
  locations     Location[]

  @@unique([cityId, slug])
  @@index([cityId, state, name, id])
}

model Location {
  id           String       @id @default(uuid()) @db.Uuid
  zoneId       String       @db.Uuid
  slug         String       @db.VarChar(100)
  name         String       @db.VarChar(160)
  latitude     Float
  longitude    Float
  state        CatalogState @default(DRAFT)
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(6)
  zone         Zone         @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  screens      Screen[]

  @@unique([zoneId, slug])
  @@index([zoneId, state, id])
  @@index([state, id])
}


// B10: private, verified media chain. No self-approved creative or public storage key.
enum CreativeAssetState {
  PENDING_UPLOAD
  UPLOADED
  PROCESSING
  READY
  REJECTED
}

enum CreativeApproval {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

model MediaAsset {
  id                String             @id @default(uuid()) @db.Uuid
  businessId        String             @db.Uuid
  uploaderUserId    String             @db.Uuid
  state             CreativeAssetState @default(PENDING_UPLOAD)
  mimeType          String             @db.VarChar(80)
  expectedBytes     Int
  expectedSha256    String             @db.Char(64)
  sourceKey         String             @unique @db.VarChar(350)
  sourceVersionId   String?            @db.VarChar(200)
  uploadExpiresAt   DateTime           @db.Timestamptz(6)
  uploadedAt        DateTime?          @db.Timestamptz(6)
  scannedAt         DateTime?          @db.Timestamptz(6)
  processedAt       DateTime?          @db.Timestamptz(6)
  sourceSha256      String?            @db.Char(64)
  processedKey      String?            @unique @db.VarChar(350)
  processedVersionId String?           @db.VarChar(200)
  processedSha256   String?            @db.Char(64)
  processedMimeType String?            @db.VarChar(80)
  width             Int?
  height            Int?
  durationMs        Int?
  failureCode       String?            @db.VarChar(100)
  processAttempts   Int                @default(0)
  createdAt         DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @db.Timestamptz(6)
  business          Business           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  creatives         Creative[]

  @@unique([id, businessId])
  @@index([businessId, state, createdAt, id])
  @@index([state, uploadedAt])
}

model Creative {
  id              String           @id @default(uuid()) @db.Uuid
  ownerBusinessId String           @db.Uuid
  title           String           @db.VarChar(180)
  placement       ScreenPlacement
  mediaAssetId    String           @db.Uuid
  approval        CreativeApproval @default(PENDING)
  reviewedByUserId String?         @db.Uuid
  reviewedAt      DateTime?        @db.Timestamptz(6)
  reviewReason    String?          @db.VarChar(1000)
  createdAt       DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(6)
  business        Business         @relation(fields: [ownerBusinessId], references: [id], onDelete: Restrict)
  asset           MediaAsset       @relation(fields: [mediaAssetId, ownerBusinessId], references: [id, businessId], onDelete: Restrict)
  decisions       CreativeReview[]
  campaigns       Campaign[]

  @@unique([id, ownerBusinessId])

  @@index([ownerBusinessId, createdAt, id])
  @@index([approval, createdAt])
}

model CreativeReview {
  id          String           @id @default(uuid()) @db.Uuid
  creativeId  String           @db.Uuid
  adminUserId String           @db.Uuid
  decision    CreativeApproval
  reason      String           @db.VarChar(1000)
  sourceSha256 String          @db.Char(64)
  processedSha256 String       @db.Char(64)
  createdAt   DateTime         @default(now()) @db.Timestamptz(6)
  creative    Creative         @relation(fields: [creativeId], references: [id], onDelete: Restrict)

  @@index([creativeId, createdAt])
}


// B11 prices are minor INR units with independently versioned tax and commercial policies.
enum DiscountKind {
  PERCENT_BPS
  FIXED_PAISE
}

model RateRule {
  id           String          @id @default(uuid()) @db.Uuid
  cityId       String          @db.Uuid
  placement    ScreenPlacement
  createdAt    DateTime        @default(now()) @db.Timestamptz(6)
  city         City            @relation(fields: [cityId], references: [id], onDelete: Restrict)
  revisions    RateRevision[]

  @@unique([cityId, placement])
}

model RateRevision {
  id                      String   @id @default(uuid()) @db.Uuid
  ruleId                  String   @db.Uuid
  version                 Int
  ratePaisePerScreenDay   Int
  active                  Boolean
  validFrom               DateTime @db.Date
  validTo                 DateTime @db.Date
  createdAt               DateTime @default(now()) @db.Timestamptz(6)
  createdByUserId         String   @db.Uuid
  rule                    RateRule @relation(fields: [ruleId], references: [id], onDelete: Restrict)

  @@unique([ruleId, version])
  @@index([ruleId, version])
}

model TaxPolicy {
  id             String    @id @default(uuid()) @db.Uuid
  version        String    @unique @db.VarChar(80)
  taxBps         Int
  sourceReference String @db.VarChar(180)
  active         Boolean
  validFrom      DateTime  @db.Date
  validTo        DateTime  @db.Date
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  createdByUserId String  @db.Uuid

  @@index([active, validFrom, validTo])
}

model DiscountPolicy {
  id             String       @id @default(uuid()) @db.Uuid
  code           String       @db.VarChar(40)
  version        Int
  kind           DiscountKind
  value          Int
  active         Boolean
  validFrom      DateTime     @db.Date
  validTo        DateTime     @db.Date
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  createdByUserId String     @db.Uuid

  @@unique([code, version])
  @@index([code, active, validFrom, validTo])
}

model PriceQuote {
  id                String    @id @default(uuid()) @db.Uuid
  businessId        String    @db.Uuid
  requestedByUserId String    @db.Uuid
  campaignId        String    @db.Uuid
  currency          String    @default("INR") @db.Char(3)
  version           Int       @default(1)
  subtotalPaise     BigInt    @db.BigInt
  discountPaise     BigInt    @db.BigInt
  taxablePaise      BigInt    @db.BigInt
  taxPaise          BigInt    @db.BigInt
  totalPaise        BigInt    @db.BigInt
  taxPolicyVersion  String    @db.VarChar(80)
  discountCode      String?   @db.VarChar(40)
  discountVersion   Int?
  startDate         DateTime  @db.Date
  endDate           DateTime  @db.Date
  selectedWeekdays  Int[]
  screenIds         String[]  @default([]) @db.Uuid
  pricingSnapshot   Json
  createdAt         DateTime  @default(now()) @db.Timestamptz(6)
  expiresAt         DateTime  @db.Timestamptz(6)
  business          Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  reservationHolds  ReservationHold[]
  paymentOrders     PaymentOrder[]

  @@index([businessId, createdAt, id])
  @@index([expiresAt])
}


// B12 campaign drafts and approved submissions never represent booking/payment.
enum CampaignState {
  DRAFT
  SUBMITTED
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  CANCELLED
}

enum CampaignDecision {
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

model Campaign {
  id              String        @id @default(uuid()) @db.Uuid
  ownerBusinessId String        @db.Uuid
  createdByUserId String        @db.Uuid
  title           String        @db.VarChar(180)
  creativeId      String        @db.Uuid
  startDate       DateTime      @db.Date
  endDate         DateTime      @db.Date
  weekdays        Int[]
  startMinute     Int           @default(0) @db.SmallInt
  endMinute       Int           @default(1440) @db.SmallInt
  status          CampaignState @default(DRAFT)
  revision        Int           @default(1)
  submissionNumber Int          @default(0)
  submittedAt     DateTime?     @db.Timestamptz(6)
  reviewedAt      DateTime?     @db.Timestamptz(6)
  reviewedByUserId String?      @db.Uuid
  reviewReason    String?       @db.VarChar(1000)
  createdAt       DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(6)
  business        Business      @relation(fields: [ownerBusinessId], references: [id], onDelete: Restrict)
  creative        Creative      @relation(fields: [creativeId, ownerBusinessId], references: [id, ownerBusinessId], onDelete: Restrict)
  submissions     CampaignSubmission[]
  reservationHolds ReservationHold[]
  paymentOrders PaymentOrder[]

  @@index([ownerBusinessId, createdAt, id])
  @@index([status, submittedAt, id])
}

model CampaignSubmission {
  id               String    @id @default(uuid()) @db.Uuid
  campaignId       String    @db.Uuid
  number           Int
  campaignRevision Int
  snapshot         Json
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  campaign         Campaign  @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  reviews          CampaignReview[]

  @@unique([campaignId, number])
}

model CampaignReview {
  id               String           @id @default(uuid()) @db.Uuid
  campaignId       String           @db.Uuid
  submissionNumber Int
  adminUserId      String           @db.Uuid
  decision         CampaignDecision
  reason           String           @db.VarChar(1000)
  snapshotHash     String           @db.Char(64)
  createdAt        DateTime         @default(now()) @db.Timestamptz(6)
  submission       CampaignSubmission @relation(fields: [campaignId, submissionNumber], references: [campaignId, number], onDelete: Restrict)

  @@unique([campaignId, submissionNumber])
  @@index([adminUserId, createdAt])
}


// B13 temporary capacity holds. One active row per entire screen calendar day.
// Expired/released holds retain their immutable historical items; active slots are freed.
enum ReservationHoldState {
  HELD
  EXPIRED
  RELEASED
  CONFIRMED
}

model ReservationHold {
  id              String               @id @default(uuid()) @db.Uuid
  businessId      String               @db.Uuid
  campaignId      String               @db.Uuid
  quoteId         String               @db.Uuid
  createdByUserId String               @db.Uuid
  state           ReservationHoldState @default(HELD)
  expiresAt       DateTime             @db.Timestamptz(6)
  releasedAt      DateTime?            @db.Timestamptz(6)
  confirmedAt     DateTime?            @db.Timestamptz(6)
  createdAt       DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime             @updatedAt @db.Timestamptz(6)
  business        Business             @relation(fields: [businessId], references: [id], onDelete: Restrict)
  campaign        Campaign             @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  quote           PriceQuote           @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  items           ReservationHoldItem[]
  activeSlots     InventorySlot[]
  paymentOrder    PaymentOrder?

  @@index([businessId, createdAt, id])
  @@index([campaignId, createdAt, id])
  @@index([state, expiresAt])
}

model ReservationHoldItem {
  id          String          @id @default(uuid()) @db.Uuid
  holdId      String          @db.Uuid
  screenId    String          @db.Uuid
  serviceDate DateTime        @db.Date
  createdAt   DateTime        @default(now()) @db.Timestamptz(6)
  hold        ReservationHold @relation(fields: [holdId], references: [id], onDelete: Restrict)
  screen      Screen          @relation(fields: [screenId], references: [id], onDelete: Restrict)

  @@unique([holdId, screenId, serviceDate])
  @@index([screenId, serviceDate])
}

model InventorySlot {
  screenId    String          @db.Uuid
  serviceDate DateTime        @db.Date
  holdId      String          @db.Uuid
  createdAt   DateTime        @default(now()) @db.Timestamptz(6)
  screen      Screen          @relation(fields: [screenId], references: [id], onDelete: Restrict)
  hold        ReservationHold @relation(fields: [holdId], references: [id], onDelete: Restrict)

  @@id([screenId, serviceDate])
  @@index([holdId])
}


// B14 Cashfree payment attempt ledger and server-verified confirmation.
// Refunds, invoices, and settlement reconciliation are reserved for B19.
enum PaymentOrderState {
  CREATING
  ACTIVE
  PAID
  PAID_UNALLOCATED
  CANCELLED
}

enum PaymentAttemptState {
  SUCCESS
  FAILED
  PENDING
  USER_DROPPED
}

model PaymentOrder {
  id                 String            @id @default(uuid()) @db.Uuid
  businessId         String            @db.Uuid
  campaignId         String            @db.Uuid
  quoteId            String            @db.Uuid
  reservationHoldId  String            @unique @db.Uuid
  createdByUserId    String            @db.Uuid
  providerOrderId    String            @unique @db.VarChar(90)
  providerSessionId  String?           @db.VarChar(350)
  currency           String            @default("INR") @db.Char(3)
  amountPaise        BigInt            @db.BigInt
  state              PaymentOrderState @default(CREATING)
  createdAt          DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime          @updatedAt @db.Timestamptz(6)
  paidAt             DateTime?         @db.Timestamptz(6)
  requiresResolution Boolean           @default(false)
  business           Business          @relation(fields:[businessId],references:[id],onDelete:Restrict)
  campaign           Campaign          @relation(fields:[campaignId],references:[id],onDelete:Restrict)
  quote              PriceQuote        @relation(fields:[quoteId],references:[id],onDelete:Restrict)
  hold               ReservationHold   @relation(fields:[reservationHoldId],references:[id],onDelete:Restrict)
  payments           PaymentAttempt[]
  webhookEvents      PaymentWebhookEvent[]

  @@index([businessId,createdAt,id])
  @@index([state,createdAt])
  @@index([requiresResolution,createdAt])
}

model PaymentAttempt {
  id                String              @id @default(uuid()) @db.Uuid
  paymentOrderId    String              @db.Uuid
  providerPaymentId String              @unique @db.VarChar(90)
  amountPaise       BigInt              @db.BigInt
  currency          String              @db.Char(3)
  status            PaymentAttemptState
  verifiedAt        DateTime            @default(now()) @db.Timestamptz(6)
  order             PaymentOrder        @relation(fields:[paymentOrderId],references:[id],onDelete:Restrict)

  @@index([paymentOrderId,verifiedAt])
}

model PaymentWebhookEvent {
  id             String        @id @default(uuid()) @db.Uuid
  paymentOrderId String        @db.Uuid
  eventHash      String        @unique @db.Char(64)
  eventType      String        @db.VarChar(80)
  receivedAt     DateTime      @default(now()) @db.Timestamptz(6)
  order          PaymentOrder  @relation(fields:[paymentOrderId],references:[id],onDelete:Restrict)

  @@index([paymentOrderId,receivedAt])
}
