  sourceReference String @db.VarChar(180)
  active         Boolean
  validFrom      DateTime  @db.Date
  validTo        DateTime  @db.Date
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  createdByUserId String  @db.Uuid

  @@index([active, validFrom, validTo])
}

model DiscountPolicy {
  id             String       @id @default(uuid()) @db.Uuid
  code           String       @db.VarChar(40)
  version        Int
  kind           DiscountKind
  value          Int
  active         Boolean
  validFrom      DateTime     @db.Date
  validTo        DateTime     @db.Date
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  createdByUserId String     @db.Uuid

  @@unique([code, version])
  @@index([code, active, validFrom, validTo])
}

model PriceQuote {
  id                String    @id @default(uuid()) @db.Uuid
  businessId        String    @db.Uuid
  requestedByUserId String    @db.Uuid
  campaignId        String    @db.Uuid
  currency          String    @default("INR") @db.Char(3)
  version           Int       @default(1)
  subtotalPaise     BigInt    @db.BigInt
  discountPaise     BigInt    @db.BigInt
  taxablePaise      BigInt    @db.BigInt
  taxPaise          BigInt    @db.BigInt
  totalPaise        BigInt    @db.BigInt
  taxPolicyVersion  String    @db.VarChar(80)
  discountCode      String?   @db.VarChar(40)
  discountVersion   Int?
  startDate         DateTime  @db.Date
  endDate           DateTime  @db.Date
