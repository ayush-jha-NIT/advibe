// AdVibe B2: initial identity and transactional infrastructure.
// Modules B5-B21 extend this schema with approved business/domain requirements.
// Prisma 6 pinned to avoid automatic Prisma 7 datasource/adapter changes.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AccountRole {
  ADVERTISER
  DRIVER
  ADMIN
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CLOSED
}

enum BusinessRole {
  OWNER
  MANAGER
  VIEWER
}

enum BusinessVerificationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum EnquiryStatus {
  NEW
  REVIEWED
  CLOSED
}

enum ChallengePurpose {
  VERIFY_EMAIL
  PASSWORD_RESET
  LOGIN_OTP
}

enum IdempotencyState {
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum OutboxState {
  PENDING
  PUBLISHED
  FAILED
}

model User {
  id              String               @id @default(uuid()) @db.Uuid
  email           String               @unique @db.VarChar(320)
  displayName     String               @db.VarChar(160)
  city            String?              @db.VarChar(100)
  passwordHash    String?              @db.VarChar(255)
  role            AccountRole          @default(ADVERTISER)
  status          AccountStatus        @default(PENDING)
  emailVerifiedAt DateTime?            @db.Timestamptz(6)
  createdAt       DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime             @updatedAt @db.Timestamptz(6)
  sessions        Session[]
  challenges      OtpChallenge[]
  ownedBusinesses Business[]           @relation("BusinessOwner")
  memberships     BusinessMembership[]
  auditEvents     AuditEvent[]         @relation("AuditActor")
  mfaCredential   AdminMfaCredential?
  mfaChallenges   MfaLoginChallenge[]
  driverApplications DriverApplication[]
  driverVehicles  Vehicle[]
  reviewedKycDocuments DriverDocument[] @relation("DocumentReviewer")
  driverReviewDecisions DriverApplicationReview[] @relation("ApplicationReviewer")

  @@index([status, createdAt])
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique @db.Char(64)
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  expiresAt  DateTime  @db.Timestamptz(6)
  lastSeenAt DateTime? @db.Timestamptz(6)
  revokedAt  DateTime? @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  mfaVerifiedAt DateTime? @db.Timestamptz(6)

  @@index([userId, revokedAt, expiresAt])
  @@index([expiresAt])
}

model OtpChallenge {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String?          @db.Uuid
  email      String           @db.VarChar(320)
  purpose    ChallengePurpose
  codeHash   String           @db.Char(64)
  attempts   Int              @default(0)
  expiresAt  DateTime         @db.Timestamptz(6)
  consumedAt DateTime?        @db.Timestamptz(6)
  createdAt  DateTime         @default(now()) @db.Timestamptz(6)
  user       User?            @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([email, purpose, createdAt])
  @@index([expiresAt])
  @@index([purpose, consumedAt, expiresAt])
}

model Business {
  id           String               @id @default(uuid()) @db.Uuid
  ownerUserId  String               @db.Uuid
  slug         String               @unique @db.VarChar(100)
  displayName  String               @db.VarChar(180)
  legalName    String?              @db.VarChar(220)
  city         String?              @db.VarChar(100)
  verificationStatus BusinessVerificationStatus @default(PENDING)
  archivedAt   DateTime?            @db.Timestamptz(6)
  createdAt    DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime             @updatedAt @db.Timestamptz(6)
  owner        User                 @relation("BusinessOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  memberships  BusinessMembership[]

  @@index([ownerUserId])
  @@index([archivedAt, createdAt])
}

model BusinessMembership {
  id         String       @id @default(uuid()) @db.Uuid
  businessId String       @db.Uuid
  userId     String       @db.Uuid
  role       BusinessRole @default(VIEWER)
  createdAt  DateTime     @default(now()) @db.Timestamptz(6)
  revokedAt  DateTime?    @db.Timestamptz(6)
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Restrict)
  user       User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([businessId, userId])
  @@index([userId, revokedAt])
}

model AuditEvent {
  id           String    @id @default(uuid()) @db.Uuid
  actorUserId  String?   @db.Uuid
  action       String    @db.VarChar(120)
  resourceType String    @db.VarChar(80)
  resourceId   String    @db.VarChar(128)
  requestId    String?   @db.VarChar(128)
  metadata     Json?
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  actor        User?     @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([resourceType, resourceId, createdAt])
  @@index([actorUserId, createdAt])
}

model IdempotencyRecord {
  id           String           @id @default(uuid()) @db.Uuid
  actorScope   String           @db.VarChar(180)
  requestPath  String           @db.VarChar(200)
  key          String           @db.VarChar(160)
  requestHash  String           @db.Char(64)
  state        IdempotencyState @default(IN_PROGRESS)
  resourceId   String?          @db.VarChar(128)
  responseCode Int?
  expiresAt    DateTime         @db.Timestamptz(6)
  createdAt    DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime         @updatedAt @db.Timestamptz(6)

  @@unique([actorScope, requestPath, key])
  @@index([expiresAt])
}

model OutboxEvent {
  id            String      @id @default(uuid()) @db.Uuid
  aggregateType String      @db.VarChar(80)
  aggregateId   String      @db.VarChar(128)
  eventType     String      @db.VarChar(160)
  payload       Json
  state         OutboxState @default(PENDING)
  attempts      Int         @default(0)
  availableAt   DateTime    @default(now()) @db.Timestamptz(6)
  publishedAt   DateTime?   @db.Timestamptz(6)
  createdAt     DateTime    @default(now()) @db.Timestamptz(6)

  @@index([state, availableAt])
  @@index([aggregateType, aggregateId, createdAt])
}

model AdminMfaCredential {
  userId       String    @id @db.Uuid
  secretCipher String    @db.VarChar(500)
  enabledAt    DateTime? @db.Timestamptz(6)
  lastUsedStep BigInt    @default(-1)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(6)
  user         User      @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model MfaLoginChallenge {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  tokenHash   String    @db.Char(64)
  attempts    Int       @default(0)
  expiresAt   DateTime  @db.Timestamptz(6)
  consumedAt  DateTime? @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  user        User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, consumedAt, expiresAt])
  @@index([expiresAt])
}

model Enquiry {
  id                String        @id @default(uuid()) @db.Uuid
  name              String        @db.VarChar(100)
  email             String        @db.VarChar(320)
  subject           String        @db.VarChar(120)
  message           String        @db.VarChar(1500)
  status            EnquiryStatus @default(NEW)
  consentAt         DateTime      @db.Timestamptz(6)
  captchaVerifiedAt DateTime      @db.Timestamptz(6)
  submitterHash     String        @db.Char(64)
  createdAt         DateTime      @default(now()) @db.Timestamptz(6)

  @@index([status, createdAt])
  @@index([createdAt])
}


// B6: application drafts are private, driver-owned, and never self-approved.
enum DriverApplicationState {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

enum DriverExperience {
  NEW
  UNDER_ONE
  ONE_TO_THREE
  OVER_THREE
}

enum VehicleType {
  BIKE
  AUTO
  CAR
}

enum VehicleVerification {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

model Vehicle {
  id                    String              @id @default(uuid()) @db.Uuid
  driverUserId          String              @db.Uuid
  type                  VehicleType
  model                 String              @db.VarChar(100)
  year                  Int
  registrationTokenHash String?             @unique @db.Char(64)
  verification          VehicleVerification @default(PENDING)
  createdAt             DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime            @updatedAt @db.Timestamptz(6)
  driver                User                @relation(fields: [driverUserId], references: [id], onDelete: Restrict)
  applications          DriverApplication[] @relation("ApplicationVehicle")
  screens               Screen[]

  @@unique([id, driverUserId])
  @@index([driverUserId, createdAt, id])
}

model DriverApplication {
  id                       String                 @id @default(uuid()) @db.Uuid
  driverUserId             String                 @db.Uuid
  state                    DriverApplicationState @default(DRAFT)
  completedStep            Int                    @default(0)
  version                  Int                    @default(0)
  city                     String?                @db.VarChar(100)
  experience               DriverExperience?
  vehicleId                String?                @db.Uuid
  vehicleCategory          VehicleType?
  screenChoice             String?                @db.VarChar(80)
  agreementTemplateVersion String?                @db.VarChar(100)
  confirmedReadiness       Boolean                @default(false)
  submittedAt              DateTime?              @db.Timestamptz(6)
  createdAt                DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime               @updatedAt @db.Timestamptz(6)
  driver                   User                   @relation(fields: [driverUserId], references: [id], onDelete: Restrict)
  vehicle                  Vehicle?               @relation("ApplicationVehicle", fields: [vehicleId, driverUserId], references: [id, driverUserId], onDelete: Restrict)

  documents DriverDocument[]
  agreements DriverAgreement[]
  reviews DriverApplicationReview[]

  @@unique([id, driverUserId])
  @@index([driverUserId, createdAt, id])
  @@index([state, submittedAt])
}

enum KycDocumentKind {
  LICENCE
  REGISTRATION
  INSURANCE
  OTHER
}
enum KycDocumentStatus {
  PENDING_UPLOAD
  UPLOADED
  SCAN_CLEAN
  SCAN_REJECTED
  VERIFIED
  REJECTED
}
enum DriverReviewDecision {
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

model DriverDocument {
  id                String            @id @default(uuid()) @db.Uuid
  applicationId     String            @db.Uuid
  driverUserId      String            @db.Uuid
  kind              KycDocumentKind
  contentType       String            @db.VarChar(60)
  sizeBytes         Int
  storageKey        String            @unique @db.VarChar(350)
  storageVersionId  String?           @db.VarChar(200)
  sha256            String?           @db.Char(64)
  status            KycDocumentStatus @default(PENDING_UPLOAD)
  uploadExpiresAt   DateTime          @db.Timestamptz(6)
  uploadedAt        DateTime?         @db.Timestamptz(6)
  scannedAt         DateTime?         @db.Timestamptz(6)
  reviewedAt        DateTime?         @db.Timestamptz(6)
  reviewedByUserId  String?           @db.Uuid
  retentionUntil    DateTime          @db.Timestamptz(6)
  createdAt         DateTime          @default(now()) @db.Timestamptz(6)
  application       DriverApplication @relation(fields: [applicationId, driverUserId], references: [id, driverUserId], onDelete: Restrict)
  reviewer          User?             @relation("DocumentReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict)
  scanEvents        KycScanEvent[]

  @@index([applicationId, kind, status])
  @@index([retentionUntil])
  @@index([driverUserId, createdAt])
}

model KycScanEvent {
  id            String         @id @default(uuid()) @db.Uuid
  providerEventId String       @unique @db.VarChar(100)
  documentId    String         @db.Uuid
  verdict       String         @db.VarChar(30)
  digest        String         @db.Char(64)
  createdAt     DateTime       @default(now()) @db.Timestamptz(6)
  document      DriverDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@index([documentId, createdAt])
}

model DriverAgreement {
  id                 String            @id @default(uuid()) @db.Uuid
  applicationId      String            @db.Uuid
  driverUserId       String            @db.Uuid
  templateVersion    String            @db.VarChar(100)
  templateSha256     String            @db.Char(64)
  privacyVersion     String            @db.VarChar(100)
  acceptedIpHash     String            @db.Char(64)
  acceptedAt         DateTime          @default(now()) @db.Timestamptz(6)
  application        DriverApplication @relation(fields: [applicationId, driverUserId], references: [id, driverUserId], onDelete: Restrict)

  @@unique([applicationId, templateVersion, templateSha256])
  @@index([driverUserId, acceptedAt])
}

model DriverApplicationReview {
  id            String               @id @default(uuid()) @db.Uuid
  applicationId String               @db.Uuid
  adminUserId   String               @db.Uuid
  decision      DriverReviewDecision
  reason        String?              @db.VarChar(2000)
  evidence      Json
  createdAt     DateTime             @default(now()) @db.Timestamptz(6)
  application   DriverApplication    @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  admin         User                 @relation("ApplicationReviewer", fields: [adminUserId], references: [id], onDelete: Restrict)

  @@index([applicationId, createdAt])
  @@index([adminUserId, createdAt])
}


// B8: provisioning and cryptographic pairing are NOT physical installation approval.
enum ScreenPlacement {
  BIKE_REAR
  AUTO_REAR
  AUTO_SIDE
  CAR_REAR
  CAR_INTERIOR
  HELMET
}

enum ScreenState {
  UNPAIRED
  PAIRED
  REVOKED
}

model Screen {
  id             String            @id @default(uuid()) @db.Uuid
  vehicleId      String            @db.Uuid
  placement      ScreenPlacement
  state          ScreenState       @default(UNPAIRED)
  installationReference String     @db.VarChar(120)
  createdAt      DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(6)
  vehicle        Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  credential     DeviceCredential?
  challenges     DevicePairingChallenge[]
  manifests      DeviceManifestVersion[]

  @@index([vehicleId, state])
}

model DeviceCredential {
  id               String    @id @default(uuid()) @db.Uuid
  screenId         String    @unique @db.Uuid
  publicKeySpki    String    @db.VarChar(256)
  fingerprint      String    @db.Char(64)
  pairedAt         DateTime  @default(now()) @db.Timestamptz(6)
  revokedAt        DateTime? @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(6)
  screen           Screen    @relation(fields: [screenId], references: [id], onDelete: Restrict)
  requestNonces    DeviceRequestNonce[]
  heartbeats       DeviceHeartbeat[]

  @@index([fingerprint])
}

model DevicePairingChallenge {
  id              String    @id @default(uuid()) @db.Uuid
  screenId        String    @db.Uuid
  adminUserId     String    @db.Uuid
  publicKeySpki   String    @db.VarChar(256)
  nonce           String    @db.VarChar(64)
  expiresAt       DateTime  @db.Timestamptz(6)
  consumedAt      DateTime? @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  screen          Screen    @relation(fields: [screenId], references: [id], onDelete: Restrict)

  @@index([screenId, consumedAt, expiresAt])
  @@index([expiresAt])
}

model DeviceRequestNonce {
  id            String           @id @default(uuid()) @db.Uuid
  credentialId  String           @db.Uuid
  nonce         String           @db.VarChar(64)
  receivedAt    DateTime         @default(now()) @db.Timestamptz(6)
  credential    DeviceCredential @relation(fields: [credentialId], references: [id], onDelete: Restrict)

  @@unique([credentialId, nonce])
  @@index([receivedAt])
}

model DeviceHeartbeat {
  id            String           @id @default(uuid()) @db.Uuid
  credentialId  String           @db.Uuid
  deviceEventId String           @db.VarChar(128)
  observedAt    DateTime         @db.Timestamptz(6)
  receivedAt    DateTime         @default(now()) @db.Timestamptz(6)
  firmwareVersion String         @db.VarChar(100)
  credential    DeviceCredential @relation(fields: [credentialId], references: [id], onDelete: Restrict)

  @@unique([credentialId, deviceEventId])
  @@index([credentialId, receivedAt])
}

model DeviceManifestVersion {
  id         String    @id @default(uuid()) @db.Uuid
  screenId   String    @db.Uuid
  version    Int
  expiresAt  DateTime  @db.Timestamptz(6)
  entries    Json
  signature  String    @db.VarChar(128)
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  screen     Screen    @relation(fields: [screenId], references: [id], onDelete: Restrict)

  @@unique([screenId, version])
}
