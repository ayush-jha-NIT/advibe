  screenIds         String[]  @default([]) @db.Uuid
  pricingSnapshot   Json
  createdAt         DateTime  @default(now()) @db.Timestamptz(6)
  expiresAt         DateTime  @db.Timestamptz(6)
  business          Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  reservationHolds  ReservationHold[]
  paymentOrders     PaymentOrder[]

  @@index([businessId, createdAt, id])
  @@index([expiresAt])
}


// B12 campaign drafts and approved submissions never represent booking/payment.
enum CampaignState {
  DRAFT
  SUBMITTED
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  CANCELLED
}

enum CampaignDecision {
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

model Campaign {
  id              String        @id @default(uuid()) @db.Uuid
  ownerBusinessId String        @db.Uuid
  createdByUserId String        @db.Uuid
  title           String        @db.VarChar(180)
  creativeId      String        @db.Uuid
  startDate       DateTime      @db.Date
  endDate         DateTime      @db.Date
  weekdays        Int[]
  startMinute     Int           @default(0) @db.SmallInt
  endMinute       Int           @default(1440) @db.SmallInt
  status          CampaignState @default(DRAFT)
  revision        Int           @default(1)
  submissionNumber Int          @default(0)
  submittedAt     DateTime?     @db.Timestamptz(6)
  reviewedAt      DateTime?     @db.Timestamptz(6)
  reviewedByUserId String?      @db.Uuid
  reviewReason    String?       @db.VarChar(1000)
  createdAt       DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(6)
  business        Business      @relation(fields: [ownerBusinessId], references: [id], onDelete: Restrict)
  creative        Creative      @relation(fields: [creativeId, ownerBusinessId], references: [id, ownerBusinessId], onDelete: Restrict)
  submissions     CampaignSubmission[]
  reservationHolds ReservationHold[]
  paymentOrders PaymentOrder[]
  deliveryPlans DeliveryPlan[]

  @@index([ownerBusinessId, createdAt, id])
  @@index([status, submittedAt, id])
}

model CampaignSubmission {
  id               String    @id @default(uuid()) @db.Uuid
  campaignId       String    @db.Uuid
  number           Int
  campaignRevision Int
  snapshot         Json
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  campaign         Campaign  @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  reviews          CampaignReview[]

  @@unique([campaignId, number])
}

model CampaignReview {
  id               String           @id @default(uuid()) @db.Uuid
  campaignId       String           @db.Uuid
  submissionNumber Int
  adminUserId      String           @db.Uuid
  decision         CampaignDecision
  reason           String           @db.VarChar(1000)
  snapshotHash     String           @db.Char(64)
  createdAt        DateTime         @default(now()) @db.Timestamptz(6)
  submission       CampaignSubmission @relation(fields: [campaignId, submissionNumber], references: [campaignId, number], onDelete: Restrict)

  @@unique([campaignId, submissionNumber])
  @@index([adminUserId, createdAt])
}


// B13 temporary capacity holds. One active row per entire screen calendar day.
// Expired/released holds retain their immutable historical items; active slots are freed.
enum ReservationHoldState {
  HELD
  EXPIRED
  RELEASED
  CONFIRMED
}

model ReservationHold {
  id              String               @id @default(uuid()) @db.Uuid
  businessId      String               @db.Uuid
  campaignId      String               @db.Uuid
  quoteId         String               @db.Uuid
  createdByUserId String               @db.Uuid
  state           ReservationHoldState @default(HELD)
  expiresAt       DateTime             @db.Timestamptz(6)
  releasedAt      DateTime?            @db.Timestamptz(6)
  confirmedAt     DateTime?            @db.Timestamptz(6)
  createdAt       DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime             @updatedAt @db.Timestamptz(6)
  business        Business             @relation(fields: [businessId], references: [id], onDelete: Restrict)
  campaign        Campaign             @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  quote           PriceQuote           @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  items           ReservationHoldItem[]
  activeSlots     InventorySlot[]
  paymentOrder    PaymentOrder?
  deliveryPlan   DeliveryPlan?

  @@index([businessId, createdAt, id])
  @@index([campaignId, createdAt, id])
  @@index([state, expiresAt])
}

model ReservationHoldItem {
  id          String          @id @default(uuid()) @db.Uuid
  holdId      String          @db.Uuid
  screenId    String          @db.Uuid
  serviceDate DateTime        @db.Date
  createdAt   DateTime        @default(now()) @db.Timestamptz(6)
  hold        ReservationHold @relation(fields: [holdId], references: [id], onDelete: Restrict)
  deliveryWindow DeliveryWindow?
  screen      Screen          @relation(fields: [screenId], references: [id], onDelete: Restrict)

  @@unique([holdId, screenId, serviceDate])
  @@index([screenId, serviceDate])
}

model InventorySlot {
  screenId    String          @db.Uuid
  serviceDate DateTime        @db.Date
  holdId      String          @db.Uuid
  createdAt   DateTime        @default(now()) @db.Timestamptz(6)
  screen      Screen          @relation(fields: [screenId], references: [id], onDelete: Restrict)
  hold        ReservationHold @relation(fields: [holdId], references: [id], onDelete: Restrict)

  @@id([screenId, serviceDate])
  @@index([holdId])
}


// B14 Cashfree payment attempt ledger and server-verified confirmation.
// Refunds, invoices, and settlement reconciliation are reserved for B19.
enum PaymentOrderState {
  CREATING
  ACTIVE
  PAID
  PAID_UNALLOCATED
  CANCELLED
}

enum PaymentAttemptState {
  SUCCESS
  FAILED
  PENDING
  USER_DROPPED
}

model PaymentOrder {
  id                 String            @id @default(uuid()) @db.Uuid
  businessId         String            @db.Uuid
  campaignId         String            @db.Uuid
  quoteId            String            @db.Uuid
  reservationHoldId  String            @unique @db.Uuid
  createdByUserId    String            @db.Uuid
  providerOrderId    String            @unique @db.VarChar(90)
  providerSessionId  String?           @db.VarChar(350)
  currency           String            @default("INR") @db.Char(3)
  amountPaise        BigInt            @db.BigInt
  state              PaymentOrderState @default(CREATING)
  createdAt          DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime          @updatedAt @db.Timestamptz(6)
  paidAt             DateTime?         @db.Timestamptz(6)
  requiresResolution Boolean           @default(false)
  business           Business          @relation(fields:[businessId],references:[id],onDelete:Restrict)
  campaign           Campaign          @relation(fields:[campaignId],references:[id],onDelete:Restrict)
  quote              PriceQuote        @relation(fields:[quoteId],references:[id],onDelete:Restrict)
  hold               ReservationHold   @relation(fields:[reservationHoldId],references:[id],onDelete:Restrict)
  payments           PaymentAttempt[]
  webhookEvents      PaymentWebhookEvent[]
  deliveryPlan       DeliveryPlan?
  invoice FinanceInvoice?
  refunds PaymentRefund[]
  reconciliationEvents FinanceReconciliationEvent[]

  @@index([businessId,createdAt,id])
  @@index([state,createdAt])
  @@index([requiresResolution,createdAt])
}

model PaymentAttempt {
  id                String              @id @default(uuid()) @db.Uuid
  paymentOrderId    String              @db.Uuid
  providerPaymentId String              @unique @db.VarChar(90)
  amountPaise       BigInt              @db.BigInt
  currency          String              @db.Char(3)
  status            PaymentAttemptState
  verifiedAt        DateTime            @default(now()) @db.Timestamptz(6)
  order             PaymentOrder        @relation(fields:[paymentOrderId],references:[id],onDelete:Restrict)

  @@index([paymentOrderId,verifiedAt])
}

model PaymentWebhookEvent {
  id             String        @id @default(uuid()) @db.Uuid
  paymentOrderId String        @db.Uuid
  eventHash      String        @unique @db.Char(64)
  eventType      String        @db.VarChar(80)
  receivedAt     DateTime      @default(now()) @db.Timestamptz(6)
  order          PaymentOrder  @relation(fields:[paymentOrderId],references:[id],onDelete:Restrict)

  @@index([paymentOrderId,receivedAt])
}

enum DeliveryState {
  SCHEDULED
  ACTIVE
  PAUSED
  COMPLETED
}
model DeliveryPlan {
  id                String          @id @default(uuid()) @db.Uuid
  reservationHoldId String          @unique @db.Uuid
  paymentOrderId    String          @unique @db.Uuid
  campaignId        String          @db.Uuid
  businessId        String          @db.Uuid
  state             DeliveryState   @default(SCHEDULED)
  revision          Int             @default(1)
  activatedAt       DateTime        @db.Timestamptz(6)
  pausedAt          DateTime?       @db.Timestamptz(6)
  resumedAt         DateTime?       @db.Timestamptz(6)
  completedAt       DateTime?       @db.Timestamptz(6)
  pauseReason       String?         @db.VarChar(1000)
  createdAt         DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @db.Timestamptz(6)
  hold              ReservationHold @relation(fields:[reservationHoldId],references:[id],onDelete:Restrict)
  order             PaymentOrder    @relation(fields:[paymentOrderId],references:[id],onDelete:Restrict)
  campaign          Campaign        @relation(fields:[campaignId],references:[id],onDelete:Restrict)
  business          Business        @relation(fields:[businessId],references:[id],onDelete:Restrict)
  windows           DeliveryWindow[]
  @@index([campaignId,state])
  @@index([businessId,createdAt])
  @@index([state,updatedAt])
}
model DeliveryWindow {
  id                String          @id @default(uuid()) @db.Uuid
  planId            String          @db.Uuid
  holdId            String          @db.Uuid
  screenId          String          @db.Uuid
  serviceDate       DateTime        @db.Date
  startsAt          DateTime        @db.Timestamptz(6)
  endsAt            DateTime        @db.Timestamptz(6)
  cityTimeZone      String          @db.VarChar(100)
  plan              DeliveryPlan    @relation(fields:[planId],references:[id],onDelete:Restrict)
  item              ReservationHoldItem @relation(fields:[holdId,screenId,serviceDate],references:[holdId,screenId,serviceDate],onDelete:Restrict)
  @@unique([planId,screenId,serviceDate])
  @@unique([holdId,screenId,serviceDate])
  @@index([screenId,startsAt,endsAt])
  @@index([planId,startsAt])
}

// B17: driver opt-in is purpose-specific and revocable. Production privacy approval is external.
model GpsConsent {
  id String @id @default(uuid()) @db.Uuid
  driverUserId String @db.Uuid
  vehicleId String @db.Uuid
  purposeVersion String @db.VarChar(100)
  grantedAt DateTime @default(now()) @db.Timestamptz(6)
  expiresAt DateTime @db.Timestamptz(6)
  revokedAt DateTime? @db.Timestamptz(6)
  driver User @relation(fields:[driverUserId],references:[id],onDelete:Restrict)
  vehicle Vehicle @relation(fields:[vehicleId,driverUserId],references:[id,driverUserId],onDelete:Restrict)
  trips TripSession[]
  @@index([vehicleId,revokedAt,expiresAt])
  @@index([driverUserId,grantedAt])
}

model TripSession {
  id String @id @default(uuid()) @db.Uuid
  vehicleId String @db.Uuid
  screenId String @db.Uuid
  consentGrantId String @db.Uuid
  startedAt DateTime @default(now()) @db.Timestamptz(6)
  endedAt DateTime? @db.Timestamptz(6)
  vehicle Vehicle @relation(fields:[vehicleId],references:[id],onDelete:Restrict)
  screen Screen @relation(fields:[screenId],references:[id],onDelete:Restrict)
  consent GpsConsent @relation(fields:[consentGrantId],references:[id],onDelete:Restrict)
  samples GpsSample[]
  proofs PlaybackProof[]
  @@index([vehicleId,startedAt])
  @@index([screenId,startedAt])
}

model GpsSample {
  id String @id @default(uuid()) @db.Uuid
  tripId String @db.Uuid
  credentialId String @db.Uuid
  eventId String @db.VarChar(128)
  observedAt DateTime @db.Timestamptz(6)
  latitude Float
  longitude Float
  accuracyMeters Float
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  trip TripSession @relation(fields:[tripId],references:[id],onDelete:Restrict)
  credential DeviceCredential @relation(fields:[credentialId],references:[id],onDelete:Restrict)
  @@unique([credentialId,eventId])
  @@index([tripId,observedAt])
  @@index([createdAt])
}

model PlaybackProof {
  id String @id @default(uuid()) @db.Uuid
  tripId String @db.Uuid
  credentialId String @db.Uuid
  screenId String @db.Uuid
  campaignId String @db.Uuid
  creativeId String @db.Uuid
  zoneId String @db.Uuid
  manifestVersion Int
  eventId String @db.VarChar(128)
  playedAt DateTime @db.Timestamptz(6)
  durationMs Int
  slotBucket DateTime @db.Timestamptz(6)
  methodVersion String @default("b17-v1") @db.VarChar(40)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  earning DriverEarning?
  trip TripSession @relation(fields:[tripId],references:[id],onDelete:Restrict)
  credential DeviceCredential @relation(fields:[credentialId],references:[id],onDelete:Restrict)
  @@unique([credentialId,eventId])
  @@unique([screenId,slotBucket])
  @@index([campaignId,playedAt])
  @@index([tripId,playedAt])
}

model ExposureAggregate {
  id String @id @default(uuid()) @db.Uuid
  campaignId String @db.Uuid
  businessId String @db.Uuid
  zoneId String @db.Uuid
  serviceDate DateTime @db.Date
  qualifiedPlaybackCount Int @default(0)
  methodVersion String @default("b17-v1") @db.VarChar(40)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  @@unique([campaignId,zoneId,serviceDate,methodVersion])
  @@index([businessId,serviceDate])
}


// B18 financial commitments are authorized participation reviews, not automatic B17 ad views.
enum SettlementState {
  READY
  PAYOUT_PENDING
  PAID
  NEEDS_REVIEW
}
enum PayoutState {
  QUEUED
  SUBMITTED
  PAID
  NEEDS_REVIEW
}
enum BeneficiaryState {
  VERIFIED
  REJECTED
}
enum DriverLedgerKind {
  EARNING
  PAYOUT
}

model EarningPolicy {
 id String @id @default(uuid()) @db.Uuid
 version String @unique @db.VarChar(80)
 paisePerReviewedEvent BigInt @db.BigInt
 activatedByUserId String @db.Uuid
 createdAt DateTime @default(now()) @db.Timestamptz(6)
 activatedBy User @relation(fields:[activatedByUserId],references:[id],onDelete:Restrict)
 earnings DriverEarning[]
}

model DriverEarning {
 id String @id @default(uuid()) @db.Uuid
 driverUserId String @db.Uuid
 sourceProofId String @unique @db.Uuid
 policyId String @db.Uuid
 reviewedByUserId String @db.Uuid
 evidenceReference String @db.VarChar(140)
 amountPaise BigInt @db.BigInt
 settlementId String? @db.Uuid
 createdAt DateTime @default(now()) @db.Timestamptz(6)
 driver User @relation("EarningDriver",fields:[driverUserId],references:[id],onDelete:Restrict)
 proof PlaybackProof @relation(fields:[sourceProofId],references:[id],onDelete:Restrict)
 policy EarningPolicy @relation(fields:[policyId],references:[id],onDelete:Restrict)
 reviewer User @relation("EarningReviewer",fields:[reviewedByUserId],references:[id],onDelete:Restrict)
 settlement DriverSettlement? @relation(fields:[settlementId],references:[id],onDelete:Restrict)
 ledger DriverLedgerEntry?
 @@index([driverUserId,settlementId,createdAt])
 @@index([settlementId])
}

model DriverLedgerEntry {
 id String @id @default(uuid()) @db.Uuid
 driverUserId String @db.Uuid
 kind DriverLedgerKind
 amountPaise BigInt @db.BigInt
 earningId String? @unique @db.Uuid
 payoutId String? @unique @db.Uuid
 createdAt DateTime @default(now()) @db.Timestamptz(6)
 earning DriverEarning? @relation(fields:[earningId],references:[id],onDelete:Restrict)
 payout DriverPayout? @relation(fields:[payoutId],references:[id],onDelete:Restrict)
 @@index([driverUserId,createdAt,id])
}

model DriverSettlement {
 id String @id @default(uuid()) @db.Uuid
 driverUserId String @db.Uuid
 periodStart DateTime @db.Date
 periodEnd DateTime @db.Date
 grossPaise BigInt @db.BigInt
 state SettlementState @default(READY)
 createdAt DateTime @default(now()) @db.Timestamptz(6)
 paidAt DateTime? @db.Timestamptz(6)
 driver User @relation("SettlementDriver",fields:[driverUserId],references:[id],onDelete:Restrict)
 earnings DriverEarning[]
 payout DriverPayout?
 @@unique([driverUserId,periodStart,periodEnd])
 @@index([driverUserId,state,createdAt])
}

model PayoutBeneficiary {
 id String @id @default(uuid()) @db.Uuid
 driverUserId String @db.Uuid
 provider String @db.VarChar(32)
 providerToken String @db.VarChar(160)
 state BeneficiaryState
 verifiedAt DateTime?
 createdAt DateTime @default(now()) @db.Timestamptz(6)
 driver User @relation(fields:[driverUserId],references:[id],onDelete:Restrict)
 payouts DriverPayout[]
 @@unique([driverUserId,provider,providerToken])
 @@index([driverUserId,state])
}

model DriverPayout {
 id String @id @default(uuid()) @db.Uuid
 settlementId String @unique @db.Uuid
 beneficiaryId String @db.Uuid
 providerReference String @unique @db.VarChar(100)
 amountPaise BigInt @db.BigInt
 state PayoutState @default(QUEUED)
 createdAt DateTime @default(now()) @db.Timestamptz(6)
 paidAt DateTime? @db.Timestamptz(6)
 settlement DriverSettlement @relation(fields:[settlementId],references:[id],onDelete:Restrict)
 beneficiary PayoutBeneficiary @relation(fields:[beneficiaryId],references:[id],onDelete:Restrict)
 ledger DriverLedgerEntry?
 webhookEvents PayoutWebhookEvent[]
 @@index([state,createdAt])
}

model PayoutWebhookEvent {
 id String @id @default(uuid()) @db.Uuid
 payoutId String @db.Uuid
 eventHash String @unique @db.Char(64)
 eventType String @db.VarChar(64)
 receivedAt DateTime @default(now()) @db.Timestamptz(6)
 payout DriverPayout @relation(fields:[payoutId],references:[id],onDelete:Restrict)
 @@index([payoutId,receivedAt])
}


// B19: legally gated invoice snapshots, idempotent refunds, credit notes and provider checks.
enum RefundState {
  QUEUED
  SUBMITTED
  SUCCEEDED
  NEEDS_REVIEW
}

enum ReconciliationState {
  MATCHED
  MISMATCH
}

model FinanceInvoiceSequence {
  financialYear String @id @db.VarChar(8)
  nextNumber Int @default(1)
}

model FinanceInvoice {
  id String @id @default(uuid()) @db.Uuid
  paymentOrderId String @unique @db.Uuid
  businessId String @db.Uuid
  invoiceNumber String @unique @db.VarChar(16)
  financialYear String @db.VarChar(4)
  issuedAt DateTime @default(now()) @db.Timestamptz(6)
  supplierName String @db.VarChar(220)
  supplierAddress String @db.VarChar(500)
  supplierGstin String @db.Char(15)
  supplierStateCode String @db.Char(2)
  recipientName String @db.VarChar(220)
  recipientAddress String @db.VarChar(500)
  recipientGstin String? @db.Char(15)
  recipientStateCode String @db.Char(2)
  placeOfSupplyCode String @db.Char(2)
  sacCode String @db.VarChar(12)
  description String @db.VarChar(250)
  taxPolicyVersion String @db.VarChar(80)
  taxMode String @db.VarChar(12)
  subtotalPaise BigInt @db.BigInt
  discountPaise BigInt @db.BigInt
  taxablePaise BigInt @db.BigInt
  cgstPaise BigInt @db.BigInt
  sgstPaise BigInt @db.BigInt
  igstPaise BigInt @db.BigInt
  totalPaise BigInt @db.BigInt
  createdByUserId String @db.Uuid
  order PaymentOrder @relation(fields:[paymentOrderId],references:[id],onDelete:Restrict)
  business Business @relation(fields:[businessId],references:[id],onDelete:Restrict)
  creditNotes FinanceCreditNote[]
  @@index([businessId,issuedAt,id])
}

model PaymentRefund {
  id String @id @default(uuid()) @db.Uuid
  paymentOrderId String @db.Uuid
  providerRefundId String @unique @db.VarChar(100)
  amountPaise BigInt @db.BigInt
  reason String @db.VarChar(500)
  policyReference String @db.VarChar(140)
  reviewedByUserId String @db.Uuid
  state RefundState @default(QUEUED)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  succeededAt DateTime? @db.Timestamptz(6)
  order PaymentOrder @relation(fields:[paymentOrderId],references:[id],onDelete:Restrict)
  creditNote FinanceCreditNote?
  @@index([paymentOrderId,state,createdAt])
  @@index([state,createdAt])
}

model FinanceCreditNote {
  id String @id @default(uuid()) @db.Uuid
  invoiceId String @db.Uuid
  refundId String @unique @db.Uuid
  noteNumber String @unique @db.VarChar(16)
  issuedAt DateTime @default(now()) @db.Timestamptz(6)
  amountPaise BigInt @db.BigInt
  taxablePaise BigInt @db.BigInt
  cgstPaise BigInt @db.BigInt
  sgstPaise BigInt @db.BigInt
  igstPaise BigInt @db.BigInt
  invoice FinanceInvoice @relation(fields:[invoiceId],references:[id],onDelete:Restrict)
  refund PaymentRefund @relation(fields:[refundId],references:[id],onDelete:Restrict)
  @@index([invoiceId,issuedAt])
}

model FinanceReconciliationEvent {
  id String @id @default(uuid()) @db.Uuid
  paymentOrderId String @db.Uuid
  providerOrderId String @db.VarChar(90)
  state ReconciliationState
  expectedPaise BigInt @db.BigInt
  providerPaise BigInt @db.BigInt
  verifiedPaymentsPaise BigInt @db.BigInt
  confirmedRefundsPaise BigInt @db.BigInt
  providerRefundsPaise BigInt @db.BigInt
  evidenceHash String @unique @db.Char(64)
  checkedByUserId String @db.Uuid
  checkedAt DateTime @default(now()) @db.Timestamptz(6)
  order PaymentOrder @relation(fields:[paymentOrderId],references:[id],onDelete:Restrict)
  @@index([paymentOrderId,checkedAt])
  @@index([state,checkedAt])
}

// B20: role-scoped support, screen maintenance, in-app notifications and leased durable jobs.
enum SupportCategory {
  GENERAL
  BILLING
  DEVICE
}
enum SupportStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}
enum TicketMessageVisibility {
  PUBLIC
  INTERNAL
}
enum MaintenanceStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}
enum NotificationKind {
  SUPPORT
  MAINTENANCE
}
enum JobState {
  PENDING
  LEASED
  COMPLETED
  DEAD
}
model SupportTicket {
  id String @id @default(uuid()) @db.Uuid
  createdByUserId String @db.Uuid
  businessId String? @db.Uuid
  screenId String? @db.Uuid
  category SupportCategory
  status SupportStatus @default(OPEN)
  subject String @db.VarChar(160)
  description String @db.VarChar(2000)
  version Int @default(1)
  assignedToUserId String? @db.Uuid
  resolvedAt DateTime? @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  messages SupportMessage[]
  maintenance ScreenMaintenance?
  @@index([createdByUserId,createdAt,id])
  @@index([businessId,createdAt,id])
  @@index([status,createdAt,id])
}
model SupportMessage {
  id String @id @default(uuid()) @db.Uuid
  ticketId String @db.Uuid
  authorUserId String @db.Uuid
  visibility TicketMessageVisibility @default(PUBLIC)
  body String @db.VarChar(2000)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  ticket SupportTicket @relation(fields:[ticketId],references:[id],onDelete:Restrict)
  @@index([ticketId,createdAt,id])
}
model ScreenMaintenance {
  id String @id @default(uuid()) @db.Uuid
  ticketId String @unique @db.Uuid
  screenId String @db.Uuid
  openedByUserId String @db.Uuid
  state MaintenanceStatus @default(OPEN)
  resolutionNote String? @db.VarChar(1500)
  openedAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  resolvedAt DateTime? @db.Timestamptz(6)
  ticket SupportTicket @relation(fields:[ticketId],references:[id],onDelete:Restrict)
  @@index([screenId,state])
}
model UserNotification {
  id String @id @default(uuid()) @db.Uuid
  recipientUserId String @db.Uuid
  ticketId String @db.Uuid
  kind NotificationKind
  dedupeKey String @unique @db.VarChar(160)
  title String @db.VarChar(120)
  body String @db.VarChar(300)
  readAt DateTime? @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  @@index([recipientUserId,createdAt,id])
  @@index([recipientUserId,readAt,createdAt])
}
model DurableJob {
  id String @id @default(uuid()) @db.Uuid
  dedupeKey String @unique @db.VarChar(160)
  recipientUserId String @db.Uuid
  ticketId String @db.Uuid
  kind NotificationKind
  title String @db.VarChar(120)
  body String @db.VarChar(300)
  state JobState @default(PENDING)
  attempts Int @default(0)
  availableAt DateTime @default(now()) @db.Timestamptz(6)
  leaseToken String? @db.Uuid
  leaseUntil DateTime? @db.Timestamptz(6)
  lastError String? @db.VarChar(160)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  completedAt DateTime? @db.Timestamptz(6)
  @@index([state,availableAt,leaseUntil])
}

// B21: immutable record of MFA-authorized status decisions (no Admin role changes).
model AccountStatusDecision {
  id String @id @default(uuid()) @db.Uuid
  subjectUserId String @db.Uuid
  administratorUserId String @db.Uuid
  previousStatus AccountStatus
  newStatus AccountStatus
  reason String @db.VarChar(500)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  subject User @relation("DecisionSubject",fields:[subjectUserId],references:[id],onDelete:Restrict)
  administrator User @relation("DecisionAdministrator",fields:[administratorUserId],references:[id],onDelete:Restrict)
  @@index([subjectUserId,createdAt,id])
  @@index([administratorUserId,createdAt,id])
}
