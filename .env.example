# Safe, non-secret frontend defaults. Copy to .env.local when developing.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=true

# Cashfree frontend public configuration is introduced in the payment module.
# Never place Cashfree secret keys or private API credentials in NEXT_PUBLIC_ variables.

# Keep demo/unapproved pages out of search results until legal and launch review.
SITE_INDEXING_ENABLED=false

# B22: explicit live backend opt-in. Leave true for public demo. Never use demo as fallback.
# NEXT_PUBLIC_DEMO_MODE=false
# ADVIBE_BACKEND_ORIGIN=https://your-private-express-api.example.com
# API bridge connects server-side and forwards HttpOnly same-site cookies.
# Backend CORS_ORIGINS must include the exact HTTPS frontend origin.
# B22 live mode is gated and does not assert production compliance or payout readiness.
